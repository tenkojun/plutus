# ─── 비밀 (절대 커밋 금지) ────────────────────────────────
keys.json
*.key
*.pem
secrets.json
.env
.env.*
.dev.vars

# ─── 런타임 데이터 (앱이 생성) ────────────────────────────
.data/
*.db
*.db-journal
*.sqlite
*.sqlite3
pc_id

# ─── 대용량 외부 자산 (앱이 자동 내려받음) ────────────────
.data/bin/
.data/kronos/
*.exe
!installer/*.exe

# ─── 빌드 산출물 ──────────────────────────────────────────
build/
dist/
# version.py 에서 생성되는 윈도우 버전 리소스
version_info.txt
*.spec.bak
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ─── 생성 리포트 / 캐시 ───────────────────────────────────
report_out/
webapp/reports/*
!webapp/reports/.gitkeep
cache/
*.parquet
*.pkl

# ─── 노드 ─────────────────────────────────────────────────
node_modules/
.wrangler/

# ─── OS / 에디터 ──────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# 작업용 임시 스크립트 (_ 로 시작)
_*.py

# 다만 보고서 번역 사전은 예외다. 파트 파일을 _ 로 시작하게 지어 놨는데
# 위 규칙에 걸려 **통째로 커밋이 안 되고 있었다** — 작업 트리는 깨끗하다고
# 나오고 사전은 저장소에 없는 상태였다. 이 디렉터리는 소스다.
!engine/jiqtx/locale/**/_*.py

# 진단 도구 산출물
plutus-진단.txt

# Inno Setup 이 받아 두는 마이크로소프트 재배포 파일 (빌드 시 자동 다운로드)
installer/vendor/

# GitHub Pages 조립 산출물 — README 가 단일 소스라 커밋하지 않는다.
# tools/build_pages.py 가 빌드할 때 만든다.
site/index.md
site/en/
site/ja/
site/zh-cn/
site/assets/
site/_site/
